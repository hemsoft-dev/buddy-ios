// Safe, source-controlled defaults. Buddy uses the same public GitHub CLI OAuth
// client strategy as CodexBar iOS. These values identify the OAuth application;
// they do not grant access to a GitHub account without browser authorization.
BUDDY_BUNDLE_IDENTIFIER = com.hemsoft.buddy

#include? "Local.xcconfig"

// Keep these assignments after Local.xcconfig so stale local values cannot make a
// distributable build incomplete. Command-line build settings still take precedence.
BUDDY_GITHUB_CLIENT_ID = 178c6fc778ccc68e1d6a
BUDDY_GITHUB_CLIENT_SECRET = 34ddeff2b558a23d38fba8a6de74f086ede1cc0b
