// Safe, source-controlled defaults. OAuth client IDs are public identifiers;
// Local.xcconfig remains available for private local values and is intentionally ignored.
BUDDY_BUNDLE_IDENTIFIER = com.hemsoft.buddy

// Configure these with a dedicated GitHub App that has Device Flow enabled and
// read-only Pull requests permission. Never substitute an OAuth App client ID.
BUDDY_GITHUB_CLIENT_ID =
BUDDY_GITHUB_APP_SLUG =

#include? "Local.xcconfig"
